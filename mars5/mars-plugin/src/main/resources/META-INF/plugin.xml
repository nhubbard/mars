<idea-plugin>
  <id>edu.missouristate.mars</id>
  <name>MARS MIPS Simulator</name>
  <version>5.0.0-SNAPSHOT</version>
  <vendor email="psanderson@otterbein.edu" url="https://github.com/missouristate/mars">
    Missouri State University
  </vendor>

  <description>MIPS Assembler and Runtime Simulator (MARS) — IntelliJ Platform plugin.</description>

  <!-- Minimum/maximum IntelliJ version compatibility. Update when targeting a specific release. -->
  <idea-version since-build="243" until-build="243.*"/>

  <extensions defaultExtensionNs="com.intellij">

    <!--
      Application-level services (one instance per IDE process).
      These are the "seams" between mars-core (Dagger-managed) and the IntelliJ service registry.

      VenusMarsGuiProxy implements MarsGuiProxy and is the bridge from the core simulator's I/O
      calls to the MARS tool-window panels.  Registered here so that:
        (a) IntelliJ creates it lazily and manages its lifecycle, and
        (b) DaggerPluginComponent exposes the same instance via PluginComponent.guiProxy().

      During migration, legacy code that calls Globals.getGui() is bridged by initializing Globals
      with the service instance returned from DaggerPluginComponent at startup:
          Globals.setGui(DaggerPluginComponent.create().guiProxy());
    -->
    <applicationService
      serviceInterface="edu.missouristate.mars.api.MarsGuiProxy"
      serviceImplementation="edu.missouristate.mars.plugin.VenusMarsGuiProxy"/>

    <!--
      Tool window registration (stub — add the factory class once VenusUI is ported).
    -->
    <!-- <toolWindow id="MARS" anchor="bottom" factoryClass="edu.missouristate.mars.plugin.MarsToolWindowFactory"/> -->

  </extensions>

  <applicationListeners>
    <!--
      Startup hook: builds the DaggerPluginComponent and wires Globals for the legacy code path.
      Uncomment once MarsStartupActivity is implemented.
    -->
    <!-- <listener class="edu.missouristate.mars.plugin.MarsStartupActivity"
              topic="com.intellij.openapi.project.ProjectManagerListener"/> -->
  </applicationListeners>

</idea-plugin>
