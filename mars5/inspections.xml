<profile version="1.0">
  <option name="myName" value="MARS 5"/>
  <!-- Literal MIPS register names are common, and both Kotlin string forms are intentional. -->
  <inspection_tool class="CanConvertToMultiDollarString" enabled="false" level="WEAK WARNING" enabled_by_default="false"/>
  <!-- The plugin targets build 263, where public experimental APIs are permitted. -->
  <inspection_tool class="UnstableApiUsage" enabled="true" level="WARNING" enabled_by_default="true">
    <option name="unstableApiAnnotations">
      <value>
        <item value="org.jetbrains.annotations.ApiStatus.ScheduledForRemoval"/>
        <item value="org.jetbrains.annotations.ApiStatus.Internal"/>
        <item value="com.intellij.openapi.util.IntellijInternalApi"/>
        <item value="com.google.common.annotations.Beta"/>
        <item value="io.reactivex.annotations.Beta"/>
        <item value="io.reactivex.annotations.Experimental"/>
        <item value="rx.annotations.Experimental"/>
        <item value="rx.annotations.Beta"/>
        <item value="org.apache.http.annotation.Beta"/>
        <item value="org.gradle.api.Incubating"/>
      </value>
    </option>
  </inspection_tool>
  <!-- Preserve distributed licenses, original acknowledgements, and historical release notes. -->
  <inspection_tool class="GrazieInspection" enabled="true" level="GRAMMAR_ERROR" enabled_by_default="true">
    <scope name="MARS preserved prose" level="GRAMMAR_ERROR" enabled="false"/>
  </inspection_tool>
  <inspection_tool class="GrazieStyle" enabled="true" level="STYLE_SUGGESTION" enabled_by_default="true">
    <!-- The catalog embeds the original MIT license as plain-text comments. -->
    <scope name="MARS preserved style" level="STYLE_SUGGESTION" enabled="false"/>
  </inspection_tool>
</profile>
