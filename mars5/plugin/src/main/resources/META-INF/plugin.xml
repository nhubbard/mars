<idea-plugin>
  <id>edu.missouristate.mars</id>
  <name>MARS MIPS</name>
  <vendor>MARS contributors</vendor>
  <description>MIPS assembly and simulation services backed by an independent session per project.</description>
  <depends>com.intellij.modules.platform</depends>
  <dependencies>
    <module name="intellij.platform.buildView"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.syntax"/>
    <module name="intellij.platform.syntax.psi"/>
    <module name="intellij.platform.syntax.util"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="MARS MIPS" language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsFileType" fieldName="INSTANCE" extensions="asm;s"/>
    <lang.syntaxHighlighterFactory language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsSyntaxHighlighterFactory"/>
    <completion.contributor language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsCompletionContributor"/>
    <codeInsight.parameterInfo language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsParameterInfoHandler"/>
    <lang.parserDefinition language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsParserDefinition"/>
    <lang.ast.factory language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.psi.MipsAstFactory"/>
    <lang.elementManipulator forClass="edu.missouristate.mars.plugin.language.psi.MipsStringLiteral" implementationClass="edu.missouristate.mars.plugin.language.psi.MipsStringManipulator"/>
    <lang.commenter language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsCommenter"/>
    <lang.braceMatcher language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsBraceMatcher"/>
    <fileBasedIndex implementation="edu.missouristate.mars.plugin.language.index.MipsDeclarationIndex"/>
    <fileBasedIndex implementation="edu.missouristate.mars.plugin.language.index.MipsReferenceIndex"/>
    <gotoSymbolContributor implementation="edu.missouristate.mars.plugin.language.MipsGoToSymbolContributor"/>
    <configurationType implementation="edu.missouristate.mars.plugin.run.MarsRunType"/>
    <runConfigurationProducer implementation="edu.missouristate.mars.plugin.run.MarsRunConfigurationProducer"/>
    <programRunner implementation="edu.missouristate.mars.plugin.run.MarsRunRunner"/>
    <programRunner implementation="edu.missouristate.mars.plugin.debug.MarsDebugRunner"/>
    <xdebugger.breakpointType implementation="edu.missouristate.mars.plugin.debug.MarsLineBreakpointType"/>
    <include.provider implementation="edu.missouristate.mars.plugin.language.index.MipsIncludeProvider"/>
    <syntax.syntaxDefinition language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsSyntaxDefinition"/>
    <syntax.elementTypeConverter language="MARS_MIPS" implementationClass="edu.missouristate.mars.plugin.language.MipsElementTypeConverterFactory"/>
  </extensions>
  <actions resource-bundle="messages.MarsBundle">
    <action id="Mars.AssembleCurrentFile" class="edu.missouristate.mars.plugin.build.MarsAssembleAction">
      <add-to-group group-id="BuildMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
