{
  generate=[psi="no" parser-api="syntax"]
  parserClass="edu.missouristate.mars.plugin.language.parser.MipsParser"
  syntaxElementTypeHolderClass="edu.missouristate.mars.plugin.language.parser.MipsSyntaxTypes"
  extends(".*_expr")=expr
  tokens=[
    WORD="regexp:[a-zA-Z_][a-zA-Z0-9_]*"
    MNEMONIC="regexp:[a-zA-Z][a-zA-Z0-9.]*"
    DIRECTIVE="regexp:\\.[a-zA-Z_]+"
    REGISTER="regexp:\\$[a-zA-Z0-9_]+"
    PARAMETER="regexp:%[a-zA-Z0-9_]+"
    NUMBER="regexp:[0-9]+"
    STRING="regexp:\"[^\"]*\""
    CHARACTER="regexp:'[^']*'"
    NEWLINE="regexp:\\r?\\n"
    COMMENT="regexp:#[^\\r\\n]*"
    UNCLOSED_STRING="regexp:\"[^\"]*"
    UNCLOSED_CHARACTER="regexp:'[^']*"
    BAD_CHARACTER="regexp:!"
    MACRO=".macro"
    END_MACRO=".end_macro"
    EQV=".eqv"
    COMMA=","
    COLON=":"
    LEFT_PAREN="("
    RIGHT_PAREN=")"
    PLUS="+"
    MINUS="-"
  ]
}
file ::= (NEWLINE | statement)*
statement ::= (label+ body? | body) {recoverWhile=line_recover}
private body ::= macro_definition | END_MACRO | equivalence | directive_statement | instruction | operation_candidate | data_continuation
private line_recover ::= !NEWLINE
label ::= name COLON
private name ::= WORD | MNEMONIC | DIRECTIVE | REGISTER
// Include expansion can supply either macro boundary from a different file.
macro_definition ::= MACRO macro_signature (NEWLINE (NEWLINE | macro_statement)* END_MACRO? | <<eof>>) {pin=1}
private macro_statement ::= !END_MACRO statement
macro_signature ::= name parameter_list?
// The assembler ignores commas and parentheses anywhere in a macro declaration.
parameter_list ::= (macro_parameter | LEFT_PAREN | RIGHT_PAREN | COMMA)+
macro_parameter ::= PARAMETER | REGISTER
// Equivalence replacement is source text, not an eagerly evaluated expression.
equivalence ::= EQV name COMMA? replacement+ {pin=1}
replacement ::= assembly_token
private assembly_token ::= WORD | MNEMONIC | DIRECTIVE | REGISTER | PARAMETER | NUMBER | STRING | CHARACTER | COMMA | COLON | LEFT_PAREN | RIGHT_PAREN | PLUS | MINUS | MACRO | END_MACRO | EQV
// Directive-specific semantic checks use the canonical Java assembler catalog.
directive_statement ::= DIRECTIVE operand_list? {pin=1}
instruction ::= operation operand_list?
operation ::= MNEMONIC
// Macro resolution, equivalence expansion, and the active segment determine the meaning of this line.
operation_candidate ::= candidate_head invocation_token*
private candidate_head ::= WORD | REGISTER | PARAMETER
invocation_token ::= assembly_token
data_continuation ::= operand_list
operand_list ::= operand (COMMA? operand)* COMMA?
operand ::= expr repetition?
repetition ::= COLON expr {pin=1}
expr ::= add_expr | unary_expr | address_expr | group_expr | literal_expr | reference_expr
add_expr ::= expr (PLUS | MINUS) expr {pin=2}
unary_expr ::= (PLUS | MINUS) expr
address_expr ::= expr LEFT_PAREN nested_expression RIGHT_PAREN {pin=2}
group_expr ::= LEFT_PAREN nested_expression RIGHT_PAREN
literal_expr ::= NUMBER | STRING | CHARACTER
reference_expr ::= WORD | MNEMONIC | REGISTER | PARAMETER | DIRECTIVE

private nested_expression ::= expr
