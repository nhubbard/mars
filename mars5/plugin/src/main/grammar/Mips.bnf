{
  generate=[psi="no" parser-api="syntax"]
  parserClass="edu.missouristate.mars.plugin.language.parser.MipsParser"
  parserImports=["edu.missouristate.mars.plugin.language.syntax.continueOperand" "edu.missouristate.mars.plugin.language.syntax.startsSignedNumber" "edu.missouristate.mars.plugin.language.syntax.isShortEquivalence" "edu.missouristate.mars.plugin.language.syntax.isIncludeLine" "edu.missouristate.mars.plugin.language.syntax.recoverBadIncludeToken" "edu.missouristate.mars.plugin.language.syntax.recoverInvalidMacroName" "edu.missouristate.mars.plugin.language.syntax.recoverInvalidMacroFormal" "edu.missouristate.mars.plugin.language.syntax.recoverMalformedMacroEnd" "edu.missouristate.mars.plugin.language.syntax.recoverCharacterLiteral" "edu.missouristate.mars.plugin.language.syntax.recoverStatement" "edu.missouristate.mars.plugin.language.syntax.parseCompleteMacroOperands"]
  syntaxElementTypeHolderClass="edu.missouristate.mars.plugin.language.parser.MipsSyntaxTypes"
  extends(".*_expr")=expr
  tokens=[
    WORD="regexp:[a-zA-Z_][a-zA-Z0-9_]*"
    MNEMONIC="regexp:[a-zA-Z][a-zA-Z0-9.]*"
    DIRECTIVE="regexp:\\.[a-zA-Z_]+"
    REGISTER="regexp:\\$[a-zA-Z0-9_]+"
    DOLLAR_WORD="regexp:\\$[a-zA-Z_][a-zA-Z0-9_]*"
    PARAMETER="regexp:%[a-zA-Z0-9_]+"
    NUMBER="regexp:[0-9]+"
    STRING="regexp:\"[^\"]*\""
    CHARACTER="regexp:'[^']*'"
    NEWLINE="regexp:\\r?\\n"
    COMMENT="regexp:#[^\\r\\n]*"
    UNCLOSED_STRING="regexp:\"[^\"]*"
    UNCLOSED_CHARACTER="regexp:'[^']*"
    INVALID_CHARACTER="regexp:'[^\r\n]*'"
    BAD_CHARACTER="regexp:!"
    MACRO=".macro"
    END_MACRO=".end_macro"
    EQV=".eqv"
    INCLUDE=".include"
    SET=".set"
    EXTERN=".extern"
    SEGMENT="regexp:\.(data|kdata|text|ktext)"
    COMMA=","
    COLON=":"
    LEFT_PAREN="("
    RIGHT_PAREN=")"
    PLUS="+"
    MINUS="-"
    EQUALITY="regexp:==|!="
    RELATION="regexp:<=|>=|<|>"
    BIT_OR="|"
    BIT_XOR="^"
    BIT_AND="&"
    BIT_NOT="~"
    SHIFT="regexp:>>>|>>|<<"
  ]
}
file ::= (NEWLINE | statement)*
// The assembler consumes one leading label; a later colon can be a macro argument.
statement ::= (include_line | label body? | body) {recoverWhile=line_recover}
// The assembler replaces the physical line before interpreting labels, macros, or operands.
include_line ::= <<isIncludeLine>> include_token+
private include_token ::= assembly_token | <<recoverBadIncludeToken>>
private body ::= macro_definition | macro_header | non_macro_body | data_continuation | <<recoverStatement>>
private non_macro_body ::= macro_end | malformed_macro_end | short_equivalence | equivalence | ignored_set | segment_switch | external_statement | directive_statement | instruction | operation_candidate
private line_recover ::= !NEWLINE
// A macro argument can supply the name of a label at expansion time.
label ::= (WORD | MNEMONIC | DOLLAR_WORD | PARAMETER) COLON
private name ::= WORD | MNEMONIC | DIRECTIVE | SET | DOLLAR_WORD | REGISTER
// Include expansion can supply either macro boundary from a different file.
macro_definition ::= MACRO &macro_name macro_signature (NEWLINE (NEWLINE | macro_statement)* macro_end? | <<eof>>) {pin=2}
private macro_statement ::= !macro_end macro_body_statement
macro_body_statement ::= (include_line | label macro_body? | macro_body) {elementType=statement recoverWhile=line_recover}
private macro_body ::= macro_header | macro_instruction | macro_directive_statement | non_macro_body | macro_data_continuation | <<recoverStatement>>
// Keep the signature for include-aware binding without opening a nested PSI body.
macro_header ::= MACRO (&macro_name macro_signature | <<recoverInvalidMacroName>>)
// MARS leaves the macro open if the closing directive has additional tokens.
private macro_end ::= END_MACRO &line_end
private malformed_macro_end ::= END_MACRO <<recoverMalformedMacroEnd>>
private line_end ::= NEWLINE | <<eof>>
// Recover a malformed parameter tail before parsing the body on the next line.
macro_signature ::= macro_name parameter_list? (&line_end | <<recoverInvalidMacroFormal>>) {pin=1}
// Only identifiers can supply macro names or be replaced by an equivalence.
private macro_name ::= WORD | DOLLAR_WORD
// The assembler ignores parentheses anywhere in a macro declaration.
parameter_list ::= (macro_parameter | LEFT_PAREN | RIGHT_PAREN)+
// A physical identifier may expand to one or more formals or parentheses.
macro_parameter ::= PARAMETER | DOLLAR_WORD | WORD
// Equivalence replacement is source text, not an eagerly evaluated expression.
short_equivalence ::= EQV <<isShortEquivalence>> raw_operand? &line_end {elementType=directive_statement}
equivalence ::= EQV name replacement+ {pin=1}
replacement ::= assembly_token
private assembly_token ::= WORD | MNEMONIC | DIRECTIVE | REGISTER | DOLLAR_WORD | PARAMETER | NUMBER | quoted_operand | CHARACTER | COLON | LEFT_PAREN | RIGHT_PAREN | signed_number | PLUS | MINUS | MACRO | END_MACRO | EQV | INCLUDE | SET | SEGMENT | EXTERN | unfinished_character
private signed_number ::= <<startsSignedNumber>> (PLUS | MINUS) NUMBER
// MARS warns and ignores .set, so its payload is a sequence of assembler tokens.
ignored_set ::= SET assembly_token* {elementType=directive_statement}
// Only the first token can supply the address, including through .eqv expansion.
segment_switch ::= SEGMENT segment_address_symbol? assembly_token* {elementType=directive_statement}
segment_address_symbol ::= WORD | DOLLAR_WORD
// Retain the same operand node when renaming a macro formal between SPIM and percent spellings.
external_statement ::= EXTERN external_name? raw_operand* {elementType=directive_statement}
// The assembler reserves the spelling even if the lexer classifies it as a register or directive.
external_name ::= name | PARAMETER
private raw_operand ::= reference_expr | assembly_token
// Directive-specific semantic checks use the canonical Java assembler catalog.
directive_statement ::= (DIRECTIVE | INCLUDE) operand_line? {pin=1}
instruction ::= operation operand_line?
// MARS stores a macro's operand tokens and validates them when the macro expands.
macro_instruction ::= operation macro_operand_line? {elementType=instruction}
macro_directive_statement ::= (DIRECTIVE | INCLUDE) macro_operand_line? {elementType=directive_statement}
private macro_operand_line ::= <<parseCompleteMacroOperands complete_operand_list>> | macro_operand_fragment
macro_operand_fragment ::= assembly_token+ {elementType=operand_fragment}
operation ::= MNEMONIC
// Macro resolution, equivalence expansion, and the active segment determine the meaning of this line.
operation_candidate ::= candidate_head invocation_token*
private candidate_head ::= WORD | DOLLAR_WORD | PARAMETER
invocation_token ::= assembly_token
data_continuation ::= operand_line
// A body line without a written operation is also deferred until expansion.
macro_data_continuation ::= macro_operand_line {elementType=data_continuation}
private operand_line ::= complete_operand_list | operand_fragment | operand_list
private complete_operand_list ::= operand_list &(NEWLINE | <<eof>>)
// Substitution can introduce syntax that balances the row only after expansion.
operand_fragment ::= &(fixed_operand_token* substitutable_operand_token) assembly_token+
private fixed_operand_token ::= !substitutable_operand_token assembly_token
private substitutable_operand_token ::= WORD | DOLLAR_WORD | PARAMETER
operand_list ::= operand+
operand ::= expr repetition?
repetition ::= COLON expr {pin=1}
// The debugger lexer alone emits comparison and bitwise tokens.
debugger_expression ::= expr <<eof>> {extraRoot=true}
expr ::= bit_or_expr | bit_xor_expr | bit_and_expr | equality_expr | relational_expr | shift_expr | add_expr | unary_expr | address_expr | group_expr | literal_expr | reference_expr
bit_or_expr ::= expr BIT_OR expr {pin=2}
bit_xor_expr ::= expr BIT_XOR expr {pin=2}
bit_and_expr ::= expr BIT_AND expr {pin=2}
equality_expr ::= expr EQUALITY expr {pin=2}
relational_expr ::= expr RELATION expr {pin=2}
shift_expr ::= expr SHIFT expr {pin=2}
add_expr ::= expr (<<continueOperand>> (PLUS | MINUS)) expr {pin=2}
unary_expr ::= (PLUS | MINUS | BIT_NOT) expr
address_expr ::= expr <<continueOperand>> LEFT_PAREN nested_expression RIGHT_PAREN {pin=2}
group_expr ::= LEFT_PAREN nested_expression RIGHT_PAREN
literal_expr ::= NUMBER | quoted_operand | CHARACTER | unfinished_character
// The assembler decides whether an unfinished quote is an error in the active context.
private quoted_operand ::= STRING | UNCLOSED_STRING
private unfinished_character ::= <<recoverCharacterLiteral>>
reference_expr ::= WORD | MNEMONIC | REGISTER | DOLLAR_WORD | PARAMETER | DIRECTIVE | SET

private nested_expression ::= expr
